# Copy this to .env and adjust values
# Never commit .env to GitHub

# ── Ollama (local — free, no API key needed) ──────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b      # use llama3.1 for the 8B version

# ── Agent behaviour ───────────────────────────────────────────────────────
MAX_SUBTOPICS=3                # how many subtopics to research
FACTS_PER_SUBTOPIC=5           # facts to extract per subtopic
TIMEOUT=120                    # seconds before LLM call times out

# ── Output ────────────────────────────────────────────────────────────────
OUTPUT_DIR=./outputs           # where reports are saved
