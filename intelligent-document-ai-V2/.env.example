# Copy to .env. Never commit .env.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
TIMEOUT=180

# Where documents are read from and results written
INBOX_DIR=./inbox
OUTPUT_DIR=./outputs

# Pipeline behaviour
MAX_REPAIR_ATTEMPTS=1      # how many times the model may correct its own extraction
MAX_DOC_CHARS=12000        # longer documents are cut AND flagged for review
MAX_FILE_BYTES=10000000    # refuse files larger than this
MONEY_TOLERANCE=0.01       # amounts within this count as equal (rounding)

# ── Controls (v2) ─────────────────────────────────────────────────────────
DB_PATH=./data/history.db            # invoice history: duplicates, vendor totals, PO usage
REGISTRY_PATH=./data/registry.json   # approved vendors and purchase orders
APPROVAL_THRESHOLD=10000             # totals at or above this always need a person
ANOMALY_FACTOR=3                     # flag totals above this multiple of the vendor's largest past invoice
ANOMALY_MIN_HISTORY=3                # ...but only once the vendor has this many accepted invoices

# ── OCR (v2) ──────────────────────────────────────────────────────────────
OCR_ENGINE=auto                      # auto | rapidocr | tesseract | none
OCR_DPI=200                          # resolution scanned PDF pages are rendered at
OCR_MIN_CONFIDENCE=85                # mean confidence below this -> review
OCR_MIN_NUMERIC_CONFIDENCE=90        # any line with digits below this -> review
OCR_FORCE_REVIEW=false               # true: every OCR'd document goes to a person
MAX_PDF_PAGES=100                    # refuse longer PDFs (OCR cost guard)
MAX_IMAGE_PIXELS=50000000            # refuse bigger images
MAX_DOCS_PER_FILE=50                 # refuse files that seem to hold more documents
